{
  "name": "all-in-one-obsidian",
  "version": "0.2.0",
  "description": "Hub pessoal e modular para o Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "mcp",
    "productivity"
  ],
  "author": "ioNe",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "1.13.1",
    "tslib": "2.6.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "braces": "git+https://github.com/micromatch/braces.git#74b2db2938fad48a2ea54a9c8bf27a37a62c350d"
  }
}
